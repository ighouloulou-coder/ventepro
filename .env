# ============================================
# 🤖 Configuration Bot Twitch - VentePro
# ============================================
# Remplacez les valeurs ci-dessous par vos informations Twitch

# Nom d'utilisateur Twitch (minuscules)
TWITCH_USERNAME=your_username

# Token OAuth (obtenu sur https://twitchapps.com/tmi/)
TWITCH_OAUTH=oauth:your_oauth_token_here

# Chaîne à rejoindre (votre nom d'utilisateur)
TWITCH_CHANNEL=your_channel

# ============================================
# Pour obtenir votre token OAuth :
# 1. Allez sur https://twitchapps.com/tmi/
# 2. Cliquez sur "Connect"
# 3. Autorisez l'application
# 4. Copiez le token (commence par oauth:)
# ============================================
