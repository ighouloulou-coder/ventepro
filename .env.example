# ============================================
# 🤖 Bot Twitch - VentePro
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs

# Nom d'utilisateur Twitch
TWITCH_USERNAME=votre_username

# Token OAuth Twitch (obtenez-le sur https://twitchapps.com/tmi/)
TWITCH_OAUTH=oauth:votre_token_ici

# Chaîne Twitch à rejoindre
TWITCH_CHANNEL=votre_channel
