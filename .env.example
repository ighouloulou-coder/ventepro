# ============================================
# 🔥 Firebase - VentePro
# ============================================
# Obtenez ces valeurs depuis https://console.firebase.google.com
# → Paramètres du projet → Général → Vos apps → Config

VITE_FIREBASE_API_KEY=votre_api_key
VITE_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=votre-projet
VITE_FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# ============================================
# 🤖 Bot Twitch - VentePro
# ============================================

# Nom d'utilisateur Twitch
TWITCH_USERNAME=votre_username

# Token OAuth Twitch (obtenez-le sur https://twitchapps.com/tmi/)
TWITCH_OAUTH=oauth:votre_token_ici

# Chaîne Twitch à rejoindre
TWITCH_CHANNEL=votre_channel
