rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/tradelink_users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function: check if user is owner or admin
    function isOwnerOrAdmin(userId) {
      return isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
    
    // ============================================
    // 🔐 USERS - Admin seulement
    // ============================================
    match /tradelink_users/{userId} {
      // Only authenticated admin can manage users
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // 📦 PRODUCTS - Auth requis
    // ============================================
    match /tradelink_products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // ============================================
    // 👥 CLIENTS - Propriétaire ou admin
    // ============================================
    match /tradelink_clients/{clientId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrAdmin(request.auth.uid);
    }
    
    // ============================================
    // 🧾 INVOICES - Propriétaire ou admin
    // ============================================
    match /tradelink_invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrAdmin(request.auth.uid);
    }
    
    // ============================================
    // 📄 QUOTES - Propriétaire ou admin
    // ============================================
    match /tradelink_quotes/{quoteId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrAdmin(request.auth.uid);
    }
    
    // ============================================
    // 📋 ORDERS - Propriétaire ou admin
    // ============================================
    match /tradelink_orders/{orderId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrAdmin(request.auth.uid);
    }
    
    // ============================================
    // 🚚 DELIVERIES - Propriétaire ou admin
    // ============================================
    match /tradelink_deliveries/{deliveryId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrAdmin(request.auth.uid);
    }
    
    // ============================================
    // 💲 PRICE TIERS - Propriétaire ou admin
    // ============================================
    match /tradelink_price_tiers/{tierId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrAdmin(request.auth.uid);
    }
    
    // ============================================
    // 🏭 SUPPLIERS - Propriétaire ou admin
    // ============================================
    match /tradelink_suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrAdmin(request.auth.uid);
    }
    
    // ============================================
    // 📋 SUPPLIER ORDERS - Propriétaire ou admin
    // ============================================
    match /tradelink_supplier_orders/{orderId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrAdmin(request.auth.uid);
    }
    
    // ============================================
    // 📄 SUPPLIER INVOICES - Propriétaire ou admin
    // ============================================
    match /tradelink_supplier_invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrAdmin(request.auth.uid);
    }
    
    // ============================================
    // 🚚 SUPPLIER DELIVERIES - Propriétaire ou admin
    // ============================================
    match /tradelink_supplier_deliveries/{deliveryId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrAdmin(request.auth.uid);
    }
    
    // ============================================
    // 💬 CHAT - Auth requis
    // ============================================
    match /tradelink_chat/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Users can only update/delete their own messages
      allow update: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
    }
    
    // ============================================
    // 🔄 WORKFLOWS - Auth requis
    // ============================================
    match /tradelink_workflows/{workflowId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // ============================================
    // ⚙️ SETTINGS - Auth requis, écriture admin
    // ============================================
    match /tradelink_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // ============================================
    // 📝 ACTIVITY LOGS - Lectures uniquement
    // ============================================
    match /tradelink_activity/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // No update/delete for audit trail
    }
    
    // ============================================
    // 💾 BACKUPS - Admin seulement
    // ============================================
    match /tradelink_backups/{backupId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
